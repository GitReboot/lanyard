# Copy this file to .env.local and fill in the values, then restart `npm run dev`.

# --- Gemini (server-side only, never exposed to the browser) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to the `gemini-flash-latest` alias so it can't go stale.
# GEMINI_MODEL=gemini-flash-latest

# --- Firebase web config ---
# Firebase console > Project settings (gear) > Your apps > Web app > firebaseConfig
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
