rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Contacts are private to the anonymous device identity that created them.
    //
    // Test-mode rules allowed unauthenticated read AND write to the whole
    // database - verified by writing a document with a plain curl and no
    // credentials. The project ID is necessarily public (it ships in the client
    // bundle), so on a public URL that exposed every scanned contact: real
    // names, emails, employers and badge photos of actual attendees.
    //
    // request.auth is populated by anonymous sign-in, so this needs no login UI.
    match /users/{uid}/contacts/{contactId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
